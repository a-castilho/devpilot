DEVPILOT_ENV=development
DEVPILOT_DATABASE_URL=sqlite:///./data/devpilot.db
DEVPILOT_DATA_DIR=./data
DEVPILOT_REPOSITORIES_DIR=./data/repositories
DEVPILOT_BOOTSTRAP_TOKEN=change-me-with-at-least-32-characters
DEVPILOT_AUTH_SECRET=change-me-with-a-random-secret-at-least-32-characters
DEVPILOT_AUTH_TOKEN_TTL_SECONDS=3600
DEVPILOT_ENCRYPTION_KEY=
DEVPILOT_EXECUTION_ENABLED=false
DEVPILOT_ALLOWED_GIT_HOSTS=github.com
DEVPILOT_OPENAI_MODEL=gpt-5.4
DEVPILOT_REALTIME_MODEL=gpt-realtime-2.1
