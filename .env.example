DEVPILOT_ENV=development
DEVPILOT_DATABASE_URL=sqlite:///./data/devpilot.db
DEVPILOT_DATA_DIR=./data
DEVPILOT_REPOSITORIES_DIR=./data/repositories
DEVPILOT_BOOTSTRAP_TOKEN=change-me-with-at-least-32-characters
DEVPILOT_ENCRYPTION_KEY=
DEVPILOT_EXECUTION_ENABLED=false
DEVPILOT_ALLOWED_GIT_HOSTS=github.com
DEVPILOT_OPENAI_MODEL=gpt-5.4
DEVPILOT_REALTIME_MODEL=gpt-realtime-2.1

# Task execution. auto = explicit read-only tasks via local Ollama; write tasks via Codex.
DEVPILOT_TASK_EXECUTOR=auto
DEVPILOT_LOCAL_READONLY_ENABLED=true
DEVPILOT_LOCAL_READONLY_MAX_FILES=40
DEVPILOT_LOCAL_READONLY_MAX_FILE_CHARS=8000
DEVPILOT_LOCAL_READONLY_MAX_CONTEXT_CHARS=40000

# AgentOS / low-memory local AI
DEVPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
DEVPILOT_OLLAMA_CHAT_ENABLED=true
DEVPILOT_OLLAMA_CHAT_MODEL=gemma3:1b
DEVPILOT_OLLAMA_EMBEDDINGS_ENABLED=true
DEVPILOT_OLLAMA_EMBEDDING_MODEL=embeddinggemma
DEVPILOT_EMBEDDING_FALLBACK_ENABLED=true
DEVPILOT_MODEL_TIMEOUT_SECONDS=60
