DEVPILOT_ENV=development
DEVPILOT_DATABASE_URL=sqlite:///./data/devpilot.db
DEVPILOT_DATA_DIR=./data
DEVPILOT_REPOSITORIES_DIR=./data/repositories
DEVPILOT_HOST_ACTIONS_DIR=./runtime/host-actions
DEVPILOT_BOOTSTRAP_TOKEN=change-me-with-at-least-32-characters
DEVPILOT_AUTH_SECRET=change-me-with-a-random-secret-at-least-32-characters
DEVPILOT_AUTH_TOKEN_TTL_SECONDS=3600
DEVPILOT_ENCRYPTION_KEY=
DEVPILOT_EXECUTION_ENABLED=false
DEVPILOT_EMBEDDED_WORKER=false
DEVPILOT_ALLOWED_GIT_HOSTS=github.com
DEVPILOT_OPENAI_MODEL=gpt-5.4
DEVPILOT_REALTIME_MODEL=gpt-realtime-2.1
# Trial/SaaS: workspaces sem credencial própria usam a cloud central do DevPilot no backend.
# O token nunca é enviado ao navegador. Desative para uma instalação 100% self-managed.
DEVPILOT_MANAGED_TRIAL_CLOUDS_ENABLED=true
DEVPILOT_MANAGED_TRIAL_WORKSPACE_SLUG=default
DEVPILOT_MANAGED_TRIAL_CLOUD_PROVIDERS=neon,render,vercel
# LinkedIn Career Sync: client secret deve ser cifrado previamente pelo Vault.
# Nunca grave o client secret em claro no .env.
DEVPILOT_LINKEDIN_CLIENT_ID=
DEVPILOT_LINKEDIN_CLIENT_SECRET_CIPHERTEXT=
# Vazio = DevPilot deriva a callback da URL da requisição. Em produção, prefira URL fixa HTTPS.
DEVPILOT_LINKEDIN_REDIRECT_URI=
DEVPILOT_LINKEDIN_SCOPES=openid,profile,email
DEVPILOT_LINKEDIN_OAUTH_STATE_TTL_SECONDS=600
# Voice conversation failover: OpenAI -> Google Gemini -> local Ollama.
DEVPILOT_VOICE_PROVIDER_ORDER=openai,google,ollama
DEVPILOT_VOICE_OPENAI_MODELS=gpt-5.6,gpt-5,gpt-4.1-mini
DEVPILOT_VOICE_GOOGLE_MODELS=gemini-2.5-flash
DEVPILOT_VOICE_OLLAMA_MODELS=phi3:mini,tinyllama
# When DevPilot runs in Docker, host.docker.internal reaches Ollama on the Linux host.
DEVPILOT_OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional display conversion. Keep 0 to show authoritative USD cost only.
DEVPILOT_USD_BRL_RATE=0
DEVPILOT_LINUX_AGENT_URL=http://127.0.0.1:8787
DEVPILOT_LINUX_AGENT_SOCKET=
DEVPILOT_LINUX_AGENT_SECRET=change-me-with-the-same-random-secret-used-by-linux-agent
DEVPILOT_LINUX_AGENT_TIMEOUT_SECONDS=5
