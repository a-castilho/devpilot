{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/build-vercel-static.mjs",
  "outputDirectory": ".vercel-static",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://devpilot-homolog.onrender.com/api/$1"
    },
    {
      "src": "/health",
      "dest": "https://devpilot-homolog.onrender.com/health"
    },
    {
      "src": "/telemetry",
      "dest": "/assets/telemetry.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/app",
      "dest": "/app.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/.*",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    }
  ]
}
