{
  "name": "DevPilot Minimal",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "DevPilot",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash -lc 'cp -n .env.example .env 2>/dev/null || true; mkdir -p data runtime/host-actions; python -m pip install --upgrade pip; pip install -e \".[test]\"'",
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false,
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.venv/**": true,
          "**/__pycache__/**": true
        }
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
